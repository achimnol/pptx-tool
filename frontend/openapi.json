            "type": "string"
          },
          "theme": {
            "$ref": "#/components/schemas/ThemeData"
          }
        },
        "required": [
          "id",
          "name",
          "theme"
        ],
        "title": "BundledThemeInfo",
        "type": "object"
      },
      "FixFontForm": {
        "properties": {
          "file": {
            "contentMediaType": "application/octet-stream",
            "format": "binary",
            "type": "string"
          },
          "theme": {
            "description": "The theme definition (ThemeData) encoded as JSON.",
            "type": "string"
          }
        },
        "required": [
          "file",
          "theme"
        ],
        "title": "FixFontForm",
        "type": "object"
      },
      "FixFontResult": {
        "properties": {
          "downloadUrl": {
            "description": "The one-time URL of the fixed pptx file, which expires if not downloaded in time. The filename query parameter overrides the suggested file name.",
            "type": "string"
          },
          "filename": {
            "description": "The suggested file name of the fixed pptx file.",
            "type": "string"
          },
          "log": {
            "type": "string"
          }
        },
        "required": [
          "downloadUrl",
          "filename",
          "log"
        ],
        "title": "FixFontResult",
        "type": "object"
      },
      "FontSet": {
        "properties": {
          "hangul": {
            "type": "string"
          },
          "latin": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          }
        },
        "required": [
          "hangul",
          "latin",
          "symbol"
        ],
        "title": "FontSet",
        "type": "object"
      },
      "FontThemeRequest": {
        "properties": {
          "name": {
            "type": "string"
          },
          "theme": {
            "$ref": "#/components/schemas/ThemeData"
          }
        },
        "required": [
          "name",
          "theme"
        ],
        "title": "FontThemeRequest",
        "type": "object"
      },
      "InstallFontThemeRequest": {
        "properties": {
          "name": {
            "type": "string"
          },
          "overwrite": {
            "default": false,
            "type": "boolean"
          },
          "theme": {
            "$ref": "#/components/schemas/ThemeData"
          }
        },
        "required": [
          "name",
          "theme"
        ],
        "title": "InstallFontThemeRequest",
        "type": "object"
      },
