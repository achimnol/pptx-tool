          },
          "maxUploadSize": {
            "type": "integer"
          }
        },
        "required": [
          "local",
          "maxUploadSize"
        ],
        "title": "AppConfig",
        "type": "object"
      },
      "BundledThemeInfo": {
        "properties": {
          "id": {
            "type": "string"
