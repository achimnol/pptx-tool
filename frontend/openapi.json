            "type": "string"
          },
          "latin": {
            "type": "string"
          }
        },
        "required": [
          "hangul",
          "latin"
        ],
        "title": "MonoFontSet",
        "type": "object"
      },
      "ThemeData": {
        "properties": {
          "majorFont": {
            "$ref": "#/components/schemas/FontSet"
          },
          "minorFont": {
            "$ref": "#/components/schemas/FontSet"
          },
          "monoFont": {
            "$ref": "#/components/schemas/MonoFontSet"
          },
          "options": {
            "$ref": "#/components/schemas/ThemeOptions"
          }
        },
        "required": [
          "majorFont",
          "minorFont",
          "monoFont",
          "options"
        ],
        "title": "ThemeData",
        "type": "object"
      },
      "ThemeOptions": {
        "properties": {
          "bodyFirstLevelStyle": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "preserveMono": {
            "default": false,
            "type": "boolean"
          },
          "titleBold": {
            "type": "boolean"
          }
        },
        "required": [
          "bodyFirstLevelStyle",
          "titleBold"
        ],
        "title": "ThemeOptions",
        "type": "object"
      }
    }
  },
